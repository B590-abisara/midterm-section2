<?xml version="1.0" encoding="utf-8"?>

<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/navigation_graph"
    app:startDestination="@id/LoginFragment">

    <fragment
        android:id="@+id/LoginFragment"
        android:name="com.example.midterm_section2.LoginFragment"
        android:label="fragment_login"
        tools:layout="@layout/fragment_login">

        <action
            android:id="@+id/navigateToPosts"
            app:destination="@id/postsFragment" />
    </fragment>

    <fragment
        android:id="@+id/postsFragment"
        android:name="com.example.midterm_section2.PostsFragment"
        android:label="fragment_posts"
        tools:layout="@layout/fragment_posts">

        <action
            android:id="@+id/navigateToLogin"
            app:destination="@id/LoginFragment"
            app:popUpTo="@id/postsFragment"
            app:popUpToInclusive="true"/>

        <action
            android:id="@+id/navigate_to_createFragment"
            app:destination="@id/createFragment" />

    </fragment>

    <fragment
        android:id="@+id/createFragment"
        android:name="com.example.midterm_section2.CreateFragment"
        android:label="fragment_create"
        tools:layout="@layout/fragment_create">

        <action
            android:id="@+id/navigate_to_postsFragment"
            app:destination="@id/postsFragment" />
    </fragment>


</navigation>
